# ========== Dependencies ==========
node_modules/

# ========== Nuxt build output ==========
# 注意：.nuxt/ 是 dev 缓存，dist/ 是构建产物，均不应提交
.nuxt/
.output/
dist/
build/
.vercel/
.netlify/

# ========== Logs ==========
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========== Environment / secrets ==========
.env
.env.*
!.env.example

# ========== OS / Editor noise ==========
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# ========== Local tool state (WorkBuddy etc.) ==========
.workbuddy/

# ========== Project docs (screenshots, local notes — not for repo) ==========
docs/
nul

# ========== nuxt-app 内部不应提交的文件 ==========
nuxt-app/.nuxt/
nuxt-app/dist/
nuxt-app/node_modules/
nuxt-app/public/docs/
