# ========== Dependencies ==========
node_modules/

# ========== Nuxt build output ==========
# 注意：.nuxt/ 是 dev 缓存，dist/ 是构建产物，均不应提交
.nuxt/
.output/
dist/
build/
.vercel/
.netlify/

# ========== Logs ==========
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========== Environment / secrets ==========
.env
.env.*
!.env.example

# ========== OS / Editor noise ==========
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# ========== Local tool state (WorkBuddy etc.) ==========
.workbuddy/

# ========== Project docs ==========
# docs/ 目录不提交，仅保留图片（README 引用的截图；赞助商图片如需上传可单独解除忽略）
docs/*
!docs/*.png
!docs/*.jpg
!docs/*.jpeg
!docs/*.gif
!docs/*.webp
!docs/*.ico
opc-doc/
Agnes*.md
Agnes*.MD

# ========== nuxt-app 内部不应提交的文件 ==========
nuxt-app/.nuxt/
nuxt-app/dist/
nuxt-app/node_modules/
# nuxt-app 内的技术笔记文档同样不提交（图片除外）
nuxt-app/docs/*
!nuxt-app/docs/*.png
!nuxt-app/docs/*.jpg
!nuxt-app/docs/*.jpeg
!nuxt-app/docs/*.gif
!nuxt-app/docs/*.webp
# nuxt-app/public/docs/ 保留赞赏码图片（部署时使用，设置页引用）
